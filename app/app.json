{
  "expo": {
    "name": "LittleKart",
    "slug": "littlekart",
    "scheme": "littlekart",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/icon/icon.png",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "in.littlekart.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon/adaptive-foreground.png",
        "monochromeImage": "./src/assets/icon/monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/brand/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-status-bar",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow LittleKart to use your location to find stores that deliver to you."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "LittleKart uses the microphone only for voice search. No audio is stored.",
          "speechRecognitionPermission": "LittleKart uses speech recognition only for voice search.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "51d49940-4303-4d85-b563-04a315965d35"
      }
    }
  }
}

{
  "expo": {
    "name": "LittleKart",
    "slug": "littlekart",
    "scheme": "littlekart",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/placeholders/app-icon.png",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "in.littlekart.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/placeholders/app-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/brand/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-status-bar",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow LittleKart to use your location to find stores that deliver to you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

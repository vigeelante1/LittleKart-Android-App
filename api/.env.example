# Copy to .env. Never commit .env.
PORT=4000
# Neon free Postgres connection string (https://neon.tech, no card needed).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/littlekart?sslmode=require
# Review mode: no SMS is sent; these numbers log in with REVIEW_OTP (DECISIONS D-12). "*" = every number.
REVIEW_PHONES=*
REVIEW_OTP=1234
# Razorpay TEST keys (https://dashboard.razorpay.com → switch to Test Mode → Settings → API Keys). Free, no card.
# Leave empty to allow only Cash on Delivery.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Settings → Webhooks → add https://<your API>/payments/webhook with events payment.captured, order.paid.
RAZORPAY_WEBHOOK_SECRET=
